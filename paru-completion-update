#!/bin/bash
# Update paru completion cache for all active users
for user_home in /home/*; do
    if [ -d "$user_home" ]; then
        username=$(basename "$user_home")
        if [ -d "$user_home/.cache/paru" ] || [ -d "$user_home/.config/paru" ]; then
            echo "Updating paru completion cache for user: $username"
            runuser -l "$username" -c "paru -Pc --completioninterval 0" >/dev/null 2>&1 &
        fi
    fi
done

if [ -d "/root/.cache/paru" ] || [ -d "/root/.config/paru" ]; then
    echo "Updating paru completion cache for user: root"
    paru -Pc --completioninterval 0 >/dev/null 2>&1 &
fi

wait
